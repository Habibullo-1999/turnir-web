# Базовый URL API.
#
# Фронт и API на одном домене — оставьте относительный путь, в разработке он
# проксируется на бэкенд (см. vite.config.ts).
VITE_API_URL=/api/v1
#
# GitHub Pages — другой домен, поэтому адрес нужен абсолютный. Переменная
# вшивается в бандл при сборке, на сервере её не прочитать:
# VITE_API_URL=https://api.example.com/api/v1


# VITE_BASE=/turnir-web/

VITE_PROXY_TARGET=http://localhost:8080
