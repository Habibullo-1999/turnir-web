{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://194.34.236.234:8081/api/:path*" },
    { "source": "/media/:path*", "destination": "http://194.34.236.234:8081/media/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
